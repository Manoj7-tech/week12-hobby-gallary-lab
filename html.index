<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manoj Portfolio</title>

  <style>
    /* 1. Basic Page Reset */
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    /* 2. Body Background and Alignment */
    body{
      font-family:Arial, sans-serif;
      background:linear-gradient(to right,#0f172a,#1e3a8a);
      color:white;
      text-align:center;
    }

    /* 3. Header Section */
    header{
      padding:40px 20px;
    }

    header h1{
      font-size:50px;
      margin-bottom:10px;
    }

    header p{
      font-size:20px;
      color:#cbd5e1;
    }

    /* 4. White Center Container Card */
    .container{
      width:90%;
      max-width:900px;
      margin:auto;
      background:white;
      color:black;
      border-radius:20px;
      padding:40px;
      box-shadow:0px 5px 20px rgba(0,0,0,0.4);
      margin-bottom:40px;
    }

    /* 5. Circular Profile Photo */
    .profile-img{
      width:250px;
      height:250px;
      object-fit:cover;
      border-radius:50%;
      border:6px solid #2563eb;
      box-shadow:0px 4px 15px rgba(0,0,0,0.3);
      margin-bottom:20px;
    }

    h2{
      color:#2563eb;
      margin-top:20px;
      margin-bottom:10px;
    }

    p{
      font-size:18px;
      line-height:1.6;
    }

    /* 6. Hobbies Layout Tag Blocks */
    .hobbies{
      display:flex;
      justify-content:center;
      gap:20px;
      flex-wrap:wrap;
      margin-top:20px;
      margin-bottom:30px;
    }

    .box{
      background:#eff6ff;
      padding:15px 25px;
      border-radius:12px;
      font-weight:bold;
      box-shadow:0px 2px 8px rgba(0,0,0,0.2);
    }

    /* 7. Beautiful Gallery Image Transitions */
    .gallery-img-style {
      width: 100%;
      max-width: 500px;
      height: 350px;
      object-fit: cover;
      border-radius: 12px;
      margin-top: 15px;
      box-shadow: 0px 4px 15px rgba(0,0,0,0.2);
      
      /* Smoothly animates opacity changes over 0.4 seconds */
      transition: opacity 0.4s ease-in-out; 
      opacity: 1;
    }

    /* Triggers the fade out effect in JS */
    .fade-out {
      opacity: 0;
    }

    /* 8. Interaction Buttons Styling */
    button{
      margin-top:20px;
      background:#2563eb;
      color:white;
      border:none;
      padding:14px 30px;
      font-size:18px;
      border-radius:30px;
      cursor:pointer;
      transition:0.3s;
    }

    button:hover{
      background:#1d4ed8;
      transform:scale(1.05);
    }

    /* 9. Footer Layout */
    footer{
      padding:20px;
      background:#0f172a;
      color:#cbd5e1;
      font-size:15px;
    }
  </style>
</head>

<body>

  <header>
    <h1>Manoj's Portfolio</h1>
    <p>Welcome to My Personal Website</p>
  </header>

  <div class="container">
    <img src="manojfootball.jpeg" alt="Manoj Photo" class="profile-img">
    
    <h2>About Me</h2>
    <p>
      Hello! My name is Manoj.<br>
      I live in Korea and I enjoy learning web development.<br>
      I love football, gaming, traveling, and exploring new technology.
    </p>

    <h2>My Hobbies</h2>
    <div class="hobbies">
      <div class="box">⚽ Football</div>
      <div class="box">🎮 Gaming</div>
      <div class="box">✈️ Traveling</div>
      <div class="box">💻 Coding</div>
    </div>

    <h2>Hobby Gallery</h2>
    <div id="hobby-gallery">
      <img id="gallery-img" class="gallery-img-style" src="https://images.unsplash.com/photo-1508098682722-e99c43a406b2?w=600&auto=format&fit=crop&q=60" alt="Football Gallery">
      <br>
      <button id="next-btn">Next Photo</button>
    </div>
  </div>

  <footer>
    © 2026 Manoj | Personal Portfolio
  </footer>

  <script>
    // Image array database holding the web paths for the slideshow
    const images = [
        "https://images.unsplash.com/photo-1508098682722-e99c43a406b2?w=600&auto=format&fit=crop&q=60", // 1. Cristiano Ronaldo
        "https://images.unsplash.com/photo-1518091043644-c1d4457512c6?w=600&auto=format&fit=crop&q=60", // 2. Goalkeeper
        "https://images.unsplash.com/photo-1544698310-74ea9d1c8258?w=600&auto=format&fit=crop&q=60"  // 3. Defending
    ];

    // Tracking counter marker index value
    let currentIndex = 0;

    // Direct Reference Pointer Selectors
    const galleryImg = document.getElementById("gallery-img");
    const nextBtn = document.getElementById("next-btn");

    // Click trigger execution event handler handler
    nextBtn.addEventListener("click", function() {
        // Step 1: Lower visibility instantly (Fade Out animation start)
        galleryImg.classList.add("fade-out");

        // Step 2: Allow 400 milliseconds delay time for execution cycle to progress 
        setTimeout(function() {
            currentIndex = currentIndex + 1;

            // Loop ceiling reset validation condition guard
            if (currentIndex >= images.length) {
                currentIndex = 0;
            }

            // Assign new picture file web resource reference path
            galleryImg.src = images[currentIndex];

            // Step 3: Strip fade class out to pull visibility right back up beautifully
            galleryImg.classList.remove("fade-out");
        }, 400); 
    });
  </script>

</body>
</html>
